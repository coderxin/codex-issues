#!/usr/bin/env bash
set -euo pipefail

STATE_ROOT="${CODEX_ISSUES_STATE_ROOT:-${XDG_STATE_HOME:-$HOME/.local/state}/codex-issues}"
WORKTREE_ROOT="${CODEX_ISSUES_WORKTREE_ROOT:-}"
SCRIPT_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")"

usage() {
  cat <<'EOF'
Usage:
  codex-issues start [options] <issue-number-or-url>...
  codex-issues list
  codex-issues status <run>
  codex-issues show <run> <issue>
  codex-issues attach <run> [issue]
  codex-issues send <run> <issue> <message...>
  codex-issues mark <run> <issue> <done|blocked>
  codex-issues cleanup <run>

Each issue starts in a fresh `codex --yolo` process, isolated Git worktree,
branch, and tmux window. Run this inside tmux to add windows to the current
session; outside tmux, a new detached session is created.

Start options:
  --model <model>                    Issue-session model
  --effort <effort>                  Issue-session reasoning effort
  --subagent-model <model>           Default model for spawned subagents
  --subagent-effort <effort>         Default effort for spawned subagents
EOF
}

die() {
  printf 'codex-issues: %s\n' "$*" >&2
  exit 1
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

run_dir() {
  [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid run name: $1"
  printf '%s/%s\n' "$STATE_ROOT" "$1"
}

load_run() {
  require_cmd tmux
  RUN_DIR="$(run_dir "$1")"
  [[ -f "$RUN_DIR/meta" && -f "$RUN_DIR/workers.tsv" ]] || die "unknown run: $1"
  RUN_DIR="$(cd "$RUN_DIR" && pwd -P)"
  IFS=$'\t' read -r SESSION REPO_ROOT WORKTREE_PARENT < "$RUN_DIR/meta"
  [[ -n "$SESSION" && -d "$REPO_ROOT" ]] || die "invalid run metadata: $1"
}

worker_row() {
  local issue="$1"
  awk -F '\t' -v issue="$issue" '$1 == issue { print; found=1; exit } END { exit !found }' "$RUN_DIR/workers.tsv"
}

# Scope styling to our windows and fence tmux IDs against server restarts.
paint_worker() {
  local state="$1" color
  case "$state" in
    working) color=blue ;;
    done) color=green ;;
    blocked|waiting) color=yellow ;;
    error) color=red ;;
    *) color=colour247 ;;
  esac
  [[ "$(tmux show-options -wqv -t "$pane_id" @codex_issue 2>/dev/null)" == "$RUN_DIR/$issue" ]] || return 0
  tmux rename-window -t "$pane_id" "#$issue $state"
  tmux set-option -w -t "$pane_id" window-status-style "fg=$color"
  tmux set-option -w -t "$pane_id" window-status-current-style "fg=black,bg=$color,bold"
}

set_state() {
  local next="$1" tmp
  tmp="$(mktemp "$RUN_DIR/prompts/issue-$issue.state.XXXXXX")"
  printf '%s\n' "$next" > "$tmp"
  mv "$tmp" "$RUN_DIR/prompts/issue-$issue.state"
  paint_worker "$next"
}

read_state() {
  state=unknown
  [[ ! -f "$RUN_DIR/prompts/issue-$issue.state" ]] || read -r state < "$RUN_DIR/prompts/issue-$issue.state"
}

# Route by hook cwd: a shared Codex server may not inherit the launcher's env.
# The command stays stable across runs so /hooks trust only needs doing once.
hook() {
  local payload cwd event thread path row issue window_id pane_id worktree branch url state tmp
  payload="$(cat)"
  cwd="$(jq -er '.cwd' <<< "$payload")"
  event="$(jq -er '.hook_event_name' <<< "$payload")"
  thread="$(jq -er '.session_id | select(test("^[A-Za-z0-9_-]+$"))' <<< "$payload")"
  [[ -d "$cwd" ]] || return 0
  cwd="$(cd "$cwd" && pwd -P)"
  for path in "$STATE_ROOT"/*; do
    [[ -f "$path/workers.tsv" ]] || continue
    row="$(awk -F '\t' -v cwd="$cwd" '$4 == cwd {print; exit}' "$path/workers.tsv")"
    [[ -n "$row" ]] || continue
    RUN_DIR="$(cd "$path" && pwd -P)"
    IFS=$'\t' read -r issue window_id pane_id worktree branch url <<< "$row"
    if [[ "$event" == SessionStart ]]; then
      tmp="$(mktemp "$RUN_DIR/prompts/issue-$issue.session.XXXXXX")"
      printf '%s\n' "$thread" > "$tmp"
      mv "$tmp" "$RUN_DIR/prompts/issue-$issue.session"
    else
      [[ -f "$RUN_DIR/prompts/issue-$issue.session" ]] || continue
      [[ "$(<"$RUN_DIR/prompts/issue-$issue.session")" == "$thread" ]] || continue
    fi
    read_state
    case "$event" in
      SessionStart) ;; # Startup/compaction does not establish a task outcome.
      UserPromptSubmit) set_state working ;;
      Stop) [[ "$state" == "done" || "$state" == blocked ]] || set_state waiting ;;
      Interrupt) set_state waiting ;;
    esac
    break
  done
  printf '{}\n'
}

hook_args() {
  local command event
  command="$(printf '%s\n' "$SCRIPT_PATH" | jq -Rr @sh) hook"
  command="env CODEX_ISSUES_STATE_ROOT=$(printf '%s\n' "$STATE_ROOT" | jq -Rr @sh) $command"
  command="$(printf '%s' "$command" | jq -Rs .)"
  HOOK_ARGS=(--enable hooks)
  for event in SessionStart UserPromptSubmit Stop Interrupt; do
    HOOK_ARGS+=(-c "hooks.$event=[{hooks=[{type=\"command\",command=$command,timeout=3}]}]")
  done
}

worker() {
  [[ $# -ge 2 && -f "$1" && -x "$2" ]] || die "worker requires a prompt file and Codex executable"
  local prompt="$1" codex_bin="$2" issue pane_id state rc=0
  shift 2
  local -a codex_args=("$@")
  RUN_DIR="$(cd "$(dirname "$prompt")/.." && pwd -P)"
  issue="$(basename "$prompt" .txt)"
  issue="${issue#issue-}"
  pane_id="${TMUX_PANE:?worker must run in tmux}"
  tmux set-option -w -t "$pane_id" @codex_issue "$RUN_DIR/$issue"
  tmux set-option -w -t "$pane_id" automatic-rename off
  tmux set-option -w -t "$pane_id" allow-rename off
  tmux set-option -w -t "$pane_id" remain-on-exit on
  set_state working
  hook_args
  "$codex_bin" --yolo "${codex_args[@]}" "${HOOK_ARGS[@]}" "$(<"$prompt")" || rc=$?
  read_state
  if [[ "$rc" -ne 0 ]]; then
    set_state error
  elif [[ "$state" != "done" && "$state" != blocked ]]; then
    set_state closed
  fi
  exit "$rc"
}

start() {
  local model="" effort="" subagent_model="" subagent_effort="" configured_effort
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --model|--effort|--subagent-model|--subagent-effort)
        [[ $# -ge 2 && -n "$2" && "$2" != -* ]] || die "$1 requires a value"
        case "$1" in
          --model) model="$2" ;;
          --effort) effort="$2" ;;
          --subagent-model) subagent_model="$2" ;;
          --subagent-effort) subagent_effort="$2" ;;
        esac
        shift 2
        ;;
      --) shift; break ;;
      -*) die "unknown start option: $1" ;;
      *) break ;;
    esac
  done
  [[ $# -gt 0 ]] || die "start requires at least one issue"
  for configured_effort in "$effort" "$subagent_effort"; do
    case "$configured_effort" in
      ''|none|low|medium|high|xhigh|max) ;;
      *) die "invalid reasoning effort: $configured_effort" ;;
    esac
  done
  require_cmd codex
  require_cmd gh
  require_cmd git
  require_cmd jq
  require_cmd tmux

  local repo_root repo_slug default_branch base_ref repo_name stamp run run_path session owns_session codex_bin encoded
  local -a codex_args=()
  codex_bin="$(command -v codex)"
  [[ -z "$model" ]] || codex_args+=(--model "$model")
  [[ -z "$effort" ]] || codex_args+=(-c "model_reasoning_effort=\"$effort\"")
  if [[ -n "$subagent_model" ]]; then
    encoded="$(jq -Rn --arg value "$subagent_model" '$value')"
    codex_args+=(-c "agents.default_subagent_model=$encoded")
  fi
  [[ -z "$subagent_effort" ]] || codex_args+=(-c "agents.default_subagent_reasoning_effort=\"$subagent_effort\"")
  "$codex_bin" queue --help >/dev/null || die "Codex with queue support is required"
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || die "run start inside a Git repository"
  repo_root="$(cd "$repo_root" && pwd -P)"
  repo_slug="$(gh repo view --json nameWithOwner --jq .nameWithOwner)"
  default_branch="$(gh repo view --json defaultBranchRef --jq .defaultBranchRef.name)"
  git fetch origin "$default_branch"
  base_ref="origin/$default_branch"
  repo_name="$(printf '%s' "$(basename "$repo_root")" | tr -cs 'A-Za-z0-9._-' '-')"
  stamp="$(date +%Y%m%d-%H%M%S)"
  run="${repo_name}-${stamp}-$$"
  run_path="$(run_dir "$run")"

  if [[ -n "${TMUX:-}" ]]; then
    session="$(tmux display-message -p '#S')"
    owns_session=0
  else
    session="cx-${repo_name}-${stamp}-$$"
    owns_session=1
  fi

  local worktree_parent
  worktree_parent="${WORKTREE_ROOT:-$(dirname "$repo_root")/.codex-issue-worktrees}/$run"
  mkdir -p "$run_path/prompts" "$worktree_parent"
  printf '%s\t%s\t%s\n' "$session" "$repo_root" "$worktree_parent" > "$run_path/meta"
  : > "$run_path/workers.tsv"
  printf '%s\n' "$codex_bin" > "$run_path/codex"
  printf 'run: %s\n' "$run"

  local issue_ref issue_json issue title body url branch worktree prompt window launch ids window_id pane_id
  local first_window=1
  for issue_ref in "$@"; do
    case "$issue_ref" in
      https://github.com/*)
        [[ "$issue_ref" == "https://github.com/$repo_slug/issues/"* ]] || die "issue is not from $repo_slug: $issue_ref"
        ;;
      *[!0-9]*|'') die "issue must be a number or GitHub issue URL: $issue_ref" ;;
    esac

    issue_json="$run_path/prompts/issue.json"
    gh issue view "$issue_ref" --repo "$repo_slug" --json number,title,body,url > "$issue_json"
    issue="$(jq -r .number "$issue_json")"
    worker_row_exists=0
    if awk -F '\t' -v issue="$issue" '$1 == issue { found=1 } END { exit !found }' "$run_path/workers.tsv"; then
      worker_row_exists=1
    fi
    [[ "$worker_row_exists" -eq 0 ]] || die "duplicate issue: $issue"

    title="$(jq -r .title "$issue_json")"
    body="$(jq -r '.body // ""' "$issue_json")"
    url="$(jq -r .url "$issue_json")"
    rm "$issue_json"

    branch="codex/issue-${issue}-${stamp}-$$"
    worktree="$worktree_parent/issue-$issue"
    prompt="$run_path/prompts/issue-$issue.txt"
    window="gh-$issue"

    git worktree add -b "$branch" "$worktree" "$base_ref"
    worktree="$(cd "$worktree" && pwd -P)"
    if ! {
      printf 'Work on GitHub issue #%s in this isolated worktree and branch.\n\n' "$issue"
      printf 'Issue: %s\nTitle: %s\n\n<github_issue>\n%s\n</github_issue>\n\n' "$url" "$title" "$body"
      printf 'Treat the issue as the task source of truth. Follow all applicable AGENTS.md instructions. '
      printf 'Own the issue end to end, verify the result, and do not work on unrelated issues. '
      printf 'If blocked or a decision is required, explain it in this session and wait for intervention.\n'
      printf 'Only the main agent should update the issue tab. Before your final response, run this command with done if all requested delivery and verification are complete, or blocked if you need human input: '
      printf 'env CODEX_ISSUES_STATE_ROOT=%q %q mark %q %q <done|blocked>\n' "$STATE_ROOT" "$SCRIPT_PATH" "$run" "$issue"
      printf 'Use blocked before asking the user a question. A done marker reports your assessment of completion, not independent verification.\n'
      printf 'If Codex warns about untrusted hooks, review the launcher hooks in /hooks so tab activity and native messaging work.\n'
    } > "$prompt"; then
      git worktree remove "$worktree"
      die "could not create prompt for issue #$issue"
    fi

    # Register cwd before Codex can emit SessionStart. Fill in tmux IDs below.
    printf '%s\t-\t-\t%s\t%s\t%s\n' "$issue" "$worktree" "$branch" "$url" >> "$run_path/workers.tsv"
    printf -v launch 'env CODEX_ISSUES_STATE_ROOT=%q %q worker %q %q' "$STATE_ROOT" "$SCRIPT_PATH" "$prompt" "$codex_bin"
    for codex_arg in "${codex_args[@]}"; do
      printf -v launch '%s %q' "$launch" "$codex_arg"
    done
    if [[ "$owns_session" -eq 1 && "$first_window" -eq 1 ]]; then
      if ! ids="$(tmux new-session -d -P -F $'#{window_id}\t#{pane_id}' -s "$session" -n "$window" -c "$worktree" "$launch")"; then
        git worktree remove "$worktree"
        rm "$prompt"
        die "could not create tmux session for issue #$issue"
      fi
      first_window=0
    else
      if ! ids="$(tmux new-window -d -P -F $'#{window_id}\t#{pane_id}' -t "$session:" -n "$window" -c "$worktree" "$launch")"; then
        git worktree remove "$worktree"
        rm "$prompt"
        die "could not create tmux window for issue #$issue"
      fi
    fi
    IFS=$'\t' read -r window_id pane_id <<< "$ids"
    awk -F '\t' -v OFS='\t' -v issue="$issue" -v window="$window_id" -v pane="$pane_id" \
      '$1 == issue {$2=window; $3=pane} {print}' "$run_path/workers.tsv" > "$run_path/workers.tsv.tmp"
    mv "$run_path/workers.tsv.tmp" "$run_path/workers.tsv"
    printf 'started #%s in %s (%s)\n' "$issue" "$window" "$worktree"
  done

  printf '\nmonitor: codex-issues status %s\nattach: codex-issues attach %s\n' "$run" "$run"
}

list_runs() {
  [[ -d "$STATE_ROOT" ]] || return 0
  local path run session repo
  for path in "$STATE_ROOT"/*; do
    [[ -f "$path/meta" ]] || continue
    run="$(basename "$path")"
    IFS=$'\t' read -r session repo _ < "$path/meta"
    printf '%-42s  %-24s  %s\n' "$run" "$session" "$repo"
  done
}

status_run() {
  local issue window_id pane_id worktree branch url process changes state
  printf '%-8s  %-10s  %-12s  %-7s  %s\n' ISSUE STATE PROCESS CHANGES WORKTREE
  while IFS=$'\t' read -r issue window_id pane_id worktree branch url; do
    if process="$(tmux display-message -p -t "$pane_id" '#{pane_current_command}' 2>/dev/null)"; then
      read_state
    else
      read_state
      [[ "$state" != working && "$state" != unknown ]] || state=closed
      process="-"
    fi
    if [[ -d "$worktree" ]]; then
      changes="$(git -C "$worktree" status --porcelain | wc -l | tr -d ' ')"
    else
      changes="-"
    fi
    printf '#%-7s  %-10s  %-12s  %-7s  %s\n' "$issue" "$state" "$process" "$changes" "$worktree"
  done < "$RUN_DIR/workers.tsv"
}

show_worker() {
  local row issue window_id pane_id worktree branch url
  row="$(worker_row "$1")" || die "issue not found in run: $1"
  IFS=$'\t' read -r issue window_id pane_id worktree branch url <<< "$row"
  tmux capture-pane -p -t "$pane_id" -S -100 2>/dev/null || die "issue #$issue is no longer running"
}

attach_run() {
  local row issue window_id pane_id worktree branch url
  if [[ $# -gt 0 ]]; then
    row="$(worker_row "$1")" || die "issue not found in run: $1"
  else
    row="$(head -n 1 "$RUN_DIR/workers.tsv")"
  fi
  IFS=$'\t' read -r issue window_id pane_id worktree branch url <<< "$row"
  tmux select-window -t "$window_id" 2>/dev/null || die "issue #$issue is no longer running"
  if [[ -n "${TMUX:-}" ]]; then
    exec tmux switch-client -t "$SESSION"
  fi
  exec tmux attach-session -t "$SESSION"
}

send_worker() {
  [[ $# -ge 2 ]] || die "send requires an issue and message"
  local target_issue="$1" row issue window_id pane_id worktree branch url thread codex_bin
  shift
  row="$(worker_row "$target_issue")" || die "issue not found in run: $target_issue"
  IFS=$'\t' read -r issue window_id pane_id worktree branch url <<< "$row"
  [[ "$(tmux show-options -wqv -t "$pane_id" @codex_issue 2>/dev/null)" == "$RUN_DIR/$issue" ]] || die "issue #$issue is no longer running"
  [[ "$(tmux display-message -p -t "$pane_id" '#{pane_dead}')" == 0 ]] || die "issue #$issue has exited"
  [[ -f "$RUN_DIR/prompts/issue-$issue.session" ]] || die "session ID unavailable; review launcher hooks in /hooks in issue #$issue, then restart or /clear the chat"
  read -r thread < "$RUN_DIR/prompts/issue-$issue.session"
  [[ "$thread" =~ ^[A-Za-z0-9_-]+$ ]] || die "invalid session ID for issue #$issue"
  read -r codex_bin < "$RUN_DIR/codex"
  "$codex_bin" queue --thread "$thread" --message "$*"
  printf 'queued message for issue #%s\n' "$issue"
}

mark_worker() {
  [[ $# -eq 2 ]] || die "mark requires an issue and done or blocked"
  case "$2" in done|blocked) ;; *) die "mark requires done or blocked" ;; esac
  local row issue window_id pane_id worktree branch url
  row="$(worker_row "$1")" || die "issue not found in run: $1"
  IFS=$'\t' read -r issue window_id pane_id worktree branch url <<< "$row"
  set_state "$2"
}

cleanup_run() {
  local issue window_id pane_id worktree branch url dirty blocked=0
  while IFS=$'\t' read -r issue window_id pane_id worktree branch url; do
    if [[ "$(tmux display-message -p -t "$pane_id" '#{pane_dead}' 2>/dev/null)" == 0 ]]; then
      printf 'codex-issues: issue #%s is still running; exit its Codex window first\n' "$issue" >&2
      blocked=1
    elif [[ -d "$worktree" ]]; then
      dirty="$(git -C "$worktree" status --porcelain)"
      if [[ -n "$dirty" ]]; then
        printf 'codex-issues: preserving dirty worktree for issue #%s: %s\n' "$issue" "$worktree" >&2
        blocked=1
      fi
    fi
  done < "$RUN_DIR/workers.tsv"
  [[ "$blocked" -eq 0 ]] || die "cleanup refused; running or dirty workers remain"

  while IFS=$'\t' read -r issue window_id pane_id worktree branch url; do
    if [[ -d "$worktree" ]]; then
      git -C "$REPO_ROOT" worktree remove "$worktree"
    fi
    if [[ "$(tmux show-options -wqv -t "$pane_id" @codex_issue 2>/dev/null)" == "$RUN_DIR/$issue" ]]; then
      [[ "$(tmux display-message -p -t "$pane_id" '#{pane_dead}')" == 1 ]] || die "issue #$issue became active during cleanup"
      tmux kill-pane -t "$pane_id"
    fi
    rm -f "$RUN_DIR/prompts/issue-$issue.txt" "$RUN_DIR/prompts/issue-$issue.state" "$RUN_DIR/prompts/issue-$issue.session"
  done < "$RUN_DIR/workers.tsv"
  git -C "$REPO_ROOT" worktree prune
  rm -f "$RUN_DIR/prompts/issue.json"
  rmdir "$WORKTREE_PARENT" 2>/dev/null || true
  rm -f "$RUN_DIR/codex"
  rm "$RUN_DIR/workers.tsv" "$RUN_DIR/meta"
  rmdir "$RUN_DIR/prompts" "$RUN_DIR"
  printf 'cleaned run %s; issue branches were retained\n' "$(basename "$RUN_DIR")"
}

command="${1:-}"
case "$command" in
  hook)
    hook
    ;;
  worker)
    shift
    worker "$@"
    ;;
  start)
    shift
    start "$@"
    ;;
  list)
    [[ $# -eq 1 ]] || die "list takes no arguments"
    list_runs
    ;;
  status|show|attach|send|mark|cleanup)
    shift
    [[ $# -gt 0 ]] || die "$command requires a run name"
    run="$1"
    shift
    load_run "$run"
    case "$command" in
      status) [[ $# -eq 0 ]] || die "status takes only a run name"; status_run ;;
      show) [[ $# -eq 1 ]] || die "show requires an issue"; show_worker "$1" ;;
      attach) [[ $# -le 1 ]] || die "attach accepts at most one issue"; attach_run "$@" ;;
      send) send_worker "$@" ;;
      mark) mark_worker "$@" ;;
      cleanup) [[ $# -eq 0 ]] || die "cleanup takes only a run name"; cleanup_run ;;
    esac
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
